APP_NAME=Orchestrix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
ADMIN_IP_WHITELIST=
APP_URL=http://localhost
# WebSocket base URL. Bo trong production (nginx proxy /ws/ -> ROOT.war). Local: ws://127.0.0.1:8080/JakartaEE-1.0-SNAPSHOT
WS_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

PASSPORT_TOKEN_EXPIRATION=365

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT_JAKARTA=predis

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Vite (Frontend)
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# Google reCAPTCHA (v2 invisible)
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# AI Plant Doctor
# Provider: gemini | openai | vit_local (model local best_vit.keras qua microservice FastAPI)
AI_PLANT_DOCTOR_PROVIDER=vit_local
AI_PLANT_DOCTOR_GEMINI_API_KEY=
AI_PLANT_DOCTOR_GEMINI_MODEL=gemini-3.1-flash-lite
AI_PLANT_DOCTOR_OPENAI_API_KEY=
AI_PLANT_DOCTOR_OPENAI_MODEL=gpt-4o

# ViT local inference (FastAPI microservice port 8501)
AI_PLANT_DOCTOR_VIT_SERVICE_URL=http://localhost:8501
AI_PLANT_DOCTOR_VIT_TOKEN=
AI_PLANT_DOCTOR_VIT_MIN_CONFIDENCE=0.45
AI_PLANT_DOCTOR_VIT_TOP_K=5
AI_PLANT_DOCTOR_VIT_TIMEOUT=30
# Bổ sung mô tả/biện pháp từ cloud sau khi ViT chẩn đoán: gemini | openai | (rỗng = bỏ qua)
AI_PLANT_DOCTOR_INFO_PROVIDER=gemini
# Tự động phát hiện lá (Grounding DINO) trước khi predict; false = predict trực tiếp ảnh gốc
AI_PLANT_DOCTOR_VIT_AUTO_DETECT=true

# Payment Gateway
PAYMENT_DEFAULT=cod
COMMISSION_RATE=5

# VNPay
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=/payment/vnpay/callback
VNPAY_IPN_URL=/payment/vnpay/ipn

# MoMo
MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api
MOMO_RETURN_URL=/payment/momo/callback
MOMO_IPN_URL=/payment/momo/ipn

# Banking
BANK_NAME="Vietcombank"
BANK_ACCOUNT="0123456789"
BANK_HOLDER="CONG TY AGRIVERSE"
BANK_BRANCH="Ha Noi"

# GHTK (Giao Hàng Tiết Kiệm)
GHTK_TOKEN=
GHTK_CLIENT_SOURCE=
GHTK_BASE_URL=https://services.giaohangtietkiem.vn

# Two-Factor Authentication
# No additional env vars needed - uses Laravel's built-in encryption

# Sentry Error Tracking (optional)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Seller Info (for tax invoices)
SELLER_TAX_ID=
SELLER_ADDRESS=

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_APIKEY=
FIREBASE_AUTHDOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGINGSENDERID=
FIREBASE_APPID=
FIREBASE_MEASUREMENTID=

# PayPal
PAYPAL_Client_ID=
PAYPAL_Secret=

# GHTK (Giao Hàng Tiết Kiệm)
GHTK_PARTNER_CODE=

# Shop Info (for invoices)
SHOP_PROVINCE=
SHOP_DISTRICT=
SHOP_WARD=
SHOP_NAME="Orchestrix Shop"
SHOP_TEL=
SHOP_ADDRESS=

# GHN (Giao Hàng Nhanh)
GHN_TOKEN=
GHN_SHOP_ID=
GHN_BASE_URL=https://dev-online-gateway.ghn.vn

# WAQI (Air Quality)
WAQI=
