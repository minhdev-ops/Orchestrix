{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["resources/js/*"],
      "@agriverse/*": ["app/Modules/AgriVerse/Resources/js/*"]
    },
    "types": ["node"]
  },
  "include": [
    "resources/js/**/*.js",
    "resources/js/**/*.vue",
    "app/Modules/AgriVerse/Resources/js/**/*.js",
    "app/Modules/AgriVerse/Resources/js/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "public",
    "storage"
  ]
}
